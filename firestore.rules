rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Friendship documents are keyed by the two user ids in sorted order, e.g. "abc_xyz".
    function pair(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function friendship(a, b) { return /databases/$(database)/documents/friendships/$(pair(a, b)); }
    function isFriend(uid) {
      return signedIn() && (me() == uid ||
        (exists(friendship(me(), uid)) && get(friendship(me(), uid)).data.status == 'accepted'));
    }

    // Private data: only the owner can read or write it.
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
      match /{rest=**} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    // @username -> owner. Anyone signed in can look one up by exact name (no listing all users).
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me() && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Public profile card: username + profile picture. Plays and stats only for accepted friends.
    match /profiles/{uid} {
      allow get: if signedIn();
      // The username shown must be one this person owns (checked against usernames/, including
      // a claim made in the same transaction), so nobody can pose as someone else.
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.usernameLower is string
        && request.resource.data.username.lower() == request.resource.data.usernameLower
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == me();
      allow delete: if signedIn() && me() == uid;
      match /plays/{id} {
        allow read: if isFriend(uid);
        allow write: if signedIn() && me() == uid;
      }
      match /meta/{id} {
        allow read: if isFriend(uid);
        allow write: if signedIn() && me() == uid;
      }
    }

    // Friend requests / friendships. Only the person asked can accept; either person can remove.
    match /friendships/{id} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && request.resource.data.to in request.resource.data.members
        && request.resource.data.to != me()
        && id == pair(request.resource.data.members[0], request.resource.data.members[1]);
      allow update: if signedIn()
        && resource.data.to == me()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.members == resource.data.members
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to;
      allow delete: if signedIn() && me() in resource.data.members;
    }
  }
}
